# Copy to .env for local runs. On Vercel, set these in the project settings.
# Switchboard holds NO private key.

# mainnet (default) or testnet
SWITCHBOARD_NETWORK=mainnet

# Wallet that receives lookup fees (an ADDRESS, not a key). Unset = lookups are free.
SWITCHBOARD_PAY_TO=
ROUTE_PRICE=$0.0001

# Optional
# EXTRA_PROVIDERS=0x...,0x...     index these even if Surety's directory doesn't list them
# SURETY_URL=https://www.surety.buzz
# RPC_URL=https://rpc.monad.xyz
# INDEX_TTL_MS=60000
# PORT=8403

# Only for examples/call.js: a small agent wallet with a little USDC
# AGENT_KEY=
