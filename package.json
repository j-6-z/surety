{
  "name": "surety",
  "version": "1.0.0",
  "description": "Bond-backed refunds for x402 AI agent payments on Monad",
  "scripts": {
    "test": "hardhat test",
    "demo": "hardhat run scripts/demo.js",
    "gas": "hardhat run scripts/gas.js",
    "bench": "hardhat run scripts/bench.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network monadTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network monadMainnet",
    "check:testnet": "node scripts/testnet-check.js",
    "check:mainnet": "node scripts/mainnet-check.js",
    "relay": "node verifier/server.js",
    "api": "node marketdata/server.js",
    "check:api": "node scripts/api-check.js",
    "start": "node start.js",
    "build": "node scripts/generate.js"
  },
  "keywords": [
    "x402",
    "monad",
    "ai-agents",
    "payments",
    "escrow",
    "solidity"
  ],
  "author": "Jay Turner",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.2",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/express": "^2.32.0",
    "@x402/fetch": "^2.32.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "marked": "^18.3.0",
    "viem": "^2.58.4"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs"
}
