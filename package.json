{
  "name": "surety",
  "version": "1.0.0",
  "description": "Bond-backed refunds for x402 AI agent payments on Monad",
  "scripts": {
    "test": "hardhat test",
    "test:sol": "node scripts/forge.js test",
    "test:sol:deep": "node scripts/forge.js test --fuzz-runs 20000",
    "test:mutants": "node scripts/mutants.js",
    "coverage:sol": "node scripts/forge.js coverage --report summary --no-match-coverage \"test|Mock\"",
    "coverage:sol:check": "node scripts/coverage-check.js",
    "lint:sol": "node scripts/forge.js lint contracts/SuretyVault.sol contracts/crosschain",
    "demo": "hardhat run scripts/demo.js",
    "gas": "hardhat run scripts/gas.js",
    "bench": "hardhat run scripts/bench.js",
    "bench:parallel": "hardhat run scripts/parallel.js",
    "deploy:testnet": "hardhat run scripts/deploy.js --network monadTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network monadMainnet",
    "check:testnet": "node scripts/testnet-check.js",
    "check:mainnet": "node scripts/mainnet-check.js",
    "crosschain": "node scripts/crosschain.js",
    "relay": "node verifier/server.js",
    "api": "node marketdata/server.js",
    "check:api": "node scripts/api-check.js",
    "start": "node start.js",
    "build": "node scripts/generate.js",
    "sync:kit": "node scripts/sync-kit.js",
    "pack:provider": "npm pack ./packages/provider --dry-run"
  },
  "keywords": [
    "x402",
    "monad",
    "ai-agents",
    "payments",
    "escrow",
    "solidity"
  ],
  "author": "Jay Turner",
  "license": "MIT",
  "devDependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.168",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.29.2",
    "solc": "^0.8.24",
    "solidity-bytes-utils": "^0.8.4"
  },
  "dependencies": {
    "@x402/core": "^2.32.0",
    "@x402/evm": "^2.32.0",
    "@x402/express": "^2.32.0",
    "@x402/fetch": "^2.32.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "marked": "^18.3.0",
    "viem": "^2.58.4"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "overrides": {
    "@eth-optimism/contracts": {
      "ethers": "$ethers"
    }
  }
}
