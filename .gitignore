# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Dependencies ----
node_modules/

# ---- Hardhat build output ----
artifacts/
cache/
coverage/
coverage.json
typechain-types/

# ---- Foundry build output ----
forge-out/
forge-cache/
lcov.info

# ---- Relay runtime data (evidence files, call log) ----
data/

# ---- Hosting ----
.vercel/

# ---- Logs and temp files ----
*.log
npm-debug.log*
*.tmp

# ---- OS and editors ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# Note: public/ and site/schedule.json are generated by `npm run build` but ARE
# committed on purpose, so the site still has its articles if a host skips the build step.
