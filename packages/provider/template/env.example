# Copy this file to .env and fill it in. Never commit .env.

# The wallet your API payments land in. Set this on your host too.
PAY_TO_ADDRESS=

# The public https address of your API, once it is hosted. Set this on your host too.
# (Vercel, Render and Railway are detected on their own if you leave it empty.)
PUBLIC_URL=

# ONLY on your own computer, for "npm run bond" and "npm run try". Never put this on your host.
# Use a testnet-only wallet with a little MON and some test USDC.
PRIVATE_KEY=

# Leave this out to use Monad testnet (test funds). Set it to mainnet for real USDC:
# set it here AND on your host. The vault contract is not audited.
# SURETY_NETWORK=mainnet
