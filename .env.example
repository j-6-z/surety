# Copy to .env and fill in. NEVER commit .env.
# Use a fresh wallet for testnet, not your main one.
PRIVATE_KEY=

# Optional overrides
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
USDC_ADDRESS=
OWNER_ADDRESS=
ARBITER_ADDRESS=
TREASURY_ADDRESS=
MIN_BOND_USDC=100
UNBONDING_DAYS=7
SLASH_FEE_BPS=500

# Relay (verifier/server.js) and scripts/testnet-check.js
VAULT_ADDRESS=
ARBITER_KEY=
RELAY_PORT=8402
# ALLOW_INSECURE=1   # local dev only: allow http:// provider and SLA URLs

# Market Data API (api/server.js)
PAY_TO_ADDRESS=
API_PORT=4021
API_PRICE=$0.001
