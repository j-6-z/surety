# Copy to .env and fill in. NEVER commit .env.
# Use a fresh wallet for testnet, not your main one.
PRIVATE_KEY=

# Optional overrides
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
USDC_ADDRESS=
OWNER_ADDRESS=
ARBITER_ADDRESS=
TREASURY_ADDRESS=
MIN_BOND_USDC=100
UNBONDING_DAYS=7
SLASH_FEE_BPS=500

# Relay (verifier/server.js) and scripts/testnet-check.js
VAULT_ADDRESS=
ARBITER_KEY=
RELAY_PORT=8402
# ALLOW_INSECURE=1   # local dev only: allow http:// provider and SLA URLs

# Market Data API (marketdata/server.js)
PAY_TO_ADDRESS=
API_PORT=4021
API_PRICE=$0.001
# API_PUBLIC_URL=https://your-api.example.com
# DATA_RPC=https://rpc.monad.xyz
# MIN_POOL_USDC=1000

# ---------------------------------------------------------------- MAINNET (real money)
# Read MAINNET.md first. The contract is not audited.
# SURETY_NETWORK=mainnet
# MONAD_MAINNET_RPC=https://rpc.monad.xyz
#
# Deploying (npm run deploy:mainnet). PRIVATE_KEY above is a throwaway deployer wallet.
# OWNER_ADDRESS=       hardware wallet or multisig. Its key never goes in any file.
# ARBITER_ADDRESS=     the relay's wallet. Different from the owner.
# TREASURY_ADDRESS=    where fees go (defaults to the owner)
# MIN_BOND_USDC=1
# I_UNDERSTAND_UNAUDITED=yes
#
# Running the server on mainnet. No owner key, ever.
# ARBITER_KEY=         the relay's key: the only key the server holds
# PROVIDER_ADDRESS=    the wallet your own API is listed and bonded under (address only)
# PAY_TO_ADDRESS=      where your API's payments land (address only)
# DEMO_KEY=            optional: a small wallet that pays for homepage demo calls
# USDC_DOMAIN_NAME=    only if "npm run check:mainnet" tells you to set it
